{
  "name": "mneme",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de copy trading: acompanha os traders do Top, pontua cada operação e sugere, simula ou executa em Solana.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "demo": "node --env-file-if-exists=.env --import tsx src/main.ts --demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:feed": "node --env-file-if-exists=.env --import tsx scripts/check-feed.ts",
    "check:wallet": "node --env-file-if-exists=.env --import tsx scripts/check-wallet.ts",
    "telegram:setup": "node --env-file-if-exists=.env --import tsx scripts/telegram-setup.ts",
    "telegram:webhook:setup": "node --env-file-if-exists=.env --import tsx scripts/register-telegram-webhook.ts",
    "acessos": "bash scripts/acessos.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th1agx/MNEME.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
